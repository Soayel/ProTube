<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mobile_shorts_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        android:orientation="vertical"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/mobile_shorts_header"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:text="@string/header_shorts"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/mobile_shorts_seek_wrap"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:background="#00000000">

        <SeekBar
            android:id="@+id/mobile_shorts_seek"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:splitTrack="false"
            android:thumbTint="#FFFFFF"
            android:progressTint="#FFFFFF"
            android:progressBackgroundTint="#66FFFFFF" />

        <TextView
            android:id="@+id/mobile_shorts_seek_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="27dp"
            android:background="#CC000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/mobile_shorts_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#0F0F0F"
        app:itemIconSize="24dp"
        app:itemIconTint="@null"
        app:itemTextColor="@color/mobile_bottom_nav_item"
        app:labelVisibilityMode="labeled" />
</FrameLayout>
