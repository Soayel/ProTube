<?xml version="1.0" encoding="utf-8"?>
<!-- Phone Settings (issue #2): one screen, one page at a time (SettingsPageFragment); each page
     carries its own top bar so the title moves with the page it names. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/newtubeColorBackground"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/settings_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:text="@string/mobile_settings_footer"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="12sp" />

</LinearLayout>
