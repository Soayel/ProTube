<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/mobile_shorts_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false"
        app:surface_type="texture_view" />

    <ImageView
        android:id="@+id/mobile_shorts_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/mobile_shorts_bottom_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginEnd="82dp"
        android:layout_marginBottom="18dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/mobile_shorts_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/mobile_shorts_handle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/mobile_shorts_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/mobile_pill_white"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Subscribe"
                android:textColor="#0F0F0F"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/mobile_shorts_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mobile_shorts_actions"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="18dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/mobile_shorts_like"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_shorts_like_outline"
            android:contentDescription="Like" />
        <ImageButton
            android:id="@+id/mobile_shorts_dislike"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_shorts_dislike_outline"
            android:contentDescription="Dislike" />
        <TextView
            android:id="@+id/mobile_shorts_comments"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Comments"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/mobile_shorts_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Share"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/mobile_shorts_save"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:drawableTop="@drawable/ic_shorts_bookmark_outline"
            android:gravity="center"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/mobile_shorts_overflow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="•••"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:letterSpacing="0.05" />
    </LinearLayout>
</FrameLayout>
